# ==========================================
# SkyFlow - Environment Variables Configuration
# ==========================================

# Application Environment
NODE_ENV=production
PORT=3000

# ------------------------------------------
# Option A: Cloud Database URL (Recommended for Render, Neon.tech, Supabase)
# ------------------------------------------
# If DATABASE_URL is set, it will take precedence over DB_HOST/PORT/etc.
# Example for Neon.tech (100% Free Forever):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.ap-southeast-1.neon.tech/neondb?sslmode=require
# Example for Render PostgreSQL (Internal URL):
# DATABASE_URL=postgres://skyflow_user:YOUR_PASSWORD@dpg-xyz-a/skyflow_db
# DB_SSL=true (default true for cloud connections, set to false only if not using SSL)

# ------------------------------------------
# Option B: Individual PostgreSQL Parameters (For Local Docker Compose)
# ------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=skyflowpass
DB_NAME=skyflow_db

# Security & Authentication
JWT_SECRET=skyflow_secret_key_2024_change_me_in_production

# Flight Data API (FlightAPI.io)
FLIGHTAPI_KEY=6abe10cfe1ceafff6e5b16d3
